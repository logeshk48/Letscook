# Copy to .env.local and fill in. Never commit .env.local.
# Get a key at https://resend.com (free tier is enough for enquiries)
RESEND_API_KEY=
# Optional: where enquiries go (defaults to the email in content/site.ts)
ENQUIRY_TO=
# Optional: a sender on a domain you verified in Resend, e.g. "Let's cook <hello@letscooktech.com>"
ENQUIRY_FROM=
